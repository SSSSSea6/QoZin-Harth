DATABASE_URL=postgres://harth:harth_dev@localhost:5432/harth
POSTGRES_PASSWORD=harth_dev

# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3001

API_PORT=3001
WEB_URL=http://localhost:3000

# 顶层身份圈，id 只能用小写字母、数字、连字符
HARTH_TOP_CIRCLE_ID=nuaa
HARTH_TOP_CIRCLE_NAME=南京航空航天大学

# 管理员的用户 id（个人页地址 /u/<id> 里的那串），逗号分隔；邮箱没有验证过，不能当身份用
HARTH_ADMIN_IDS=

# 站点模式：production 对外运营，preview 内部预览（生产构建默认 production）
HARTH_SITE_MODE=preview

# 发言前必须绑定手机号；只有 preview 模式可以设 0
HARTH_PHONE_REQUIRED=1

# 阿里云短信（验证码）。不填则发码接口返回 503、门禁照拦。RAM 子账号只给 dysms:SendSms
HARTH_SMS_ACCESS_KEY_ID=
HARTH_SMS_ACCESS_KEY_SECRET=
HARTH_SMS_SIGN_NAME=
HARTH_SMS_TEMPLATE_CODE=

# iOS 推送：苹果 APNs 的 .p8 密钥（base64 整个文件）、Key ID、Team ID、App 的 bundle id；不填则 iOS 不推送
HARTH_APNS_KEY=
HARTH_APNS_KEY_ID=
HARTH_APNS_TEAM_ID=
HARTH_APNS_BUNDLE_ID=
HARTH_APNS_ENV=production

# 安卓推送：阿里云 EMAS 推送的 RAM 子账号与应用 appKey；不填则安卓不推送
HARTH_EMAS_ACCESS_KEY_ID=
HARTH_EMAS_ACCESS_KEY_SECRET=
HARTH_EMAS_APP_KEY=
HARTH_EMAS_REGION=cn-hangzhou

# 工具审核用的模型（OpenAI 兼容接口）；不填则只做自动检查，剩下由管理员人工审
HARTH_REVIEW_API_URL=https://api.deepseek.com/v1
HARTH_REVIEW_API_KEY=
HARTH_REVIEW_MODEL=deepseek-chat

# docker compose 全栈时使用；工具页面必须与站点不同源
SITE_URL=http://localhost
TOOLS_URL=http://tools.localhost
NPM_REGISTRY=https://registry.npmjs.org
