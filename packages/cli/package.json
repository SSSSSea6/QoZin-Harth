    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@harth/shared": "workspace:*",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
