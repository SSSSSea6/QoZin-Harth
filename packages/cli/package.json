{
  "name": "harth",
  "version": "0.1.0",
  "description": "火塘开发者 CLI：把你做的工具接进圈子",
  "license": "AGPL-3.0",
  "type": "module",
  "bin": {
    "harth": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
